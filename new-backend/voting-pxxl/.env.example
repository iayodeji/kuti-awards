# Copy to .env for local dev (npm run dev). On Pxxl, set these in the app's environment variables.

# Postgres connection string from your database
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to true if the database requires SSL and the connection fails without it
DATABASE_SSL=false
# Max simultaneous DB connections from this app (keep below your plan's connection limit)
DB_POOL_MAX=10

# device = open voting, one ballot per device, no email (default). link = emailed single-use links.
VOTER_MODE=device

# Long random strings (e.g. openssl rand -hex 32).
# COOKIE_SECRET (device mode): signs voter cookies and hashes fingerprints/IPs. Do not change mid-vote.
COOKIE_SECRET=change-me
# EMAIL_PEPPER (link mode only): must never change after you issue links.
EMAIL_PEPPER=change-me
ADMIN_KEY=change-me

# Device mode: max distinct ballots from one IP (0 = off). Soft limit; hall/campus Wi-Fi can share an IP.
IP_BALLOT_CAP=1000

# ISO 8601 with offset. Leave empty for no window.
VOTING_OPENS=2026-11-10T08:00:00+01:00
VOTING_CLOSES=2026-11-17T23:59:00+01:00

# true = voter must also type the email the link was sent to
REQUIRE_EMAIL_CONFIRM=true

# Only needed if your UI is hosted on a different domain than this backend (comma separated)
CORS_ORIGIN=

# Rate limits per minute. Per-IP is deliberately high: a campus or hall can put hundreds of
# voters behind one IP. Voter links are 256-bit random, so they cannot be guessed anyway.
RATE_IP_PER_MIN=6000
RATE_TOKEN_PER_MIN=30
# How many proxy hops sit in front of the app (1 for most PaaS)
TRUST_PROXY=1
